# App: role sem ownership nem BYPASSRLS; URL com -pooler.
DATABASE_URL=
# Exclusivamente migrações; nunca expor na app/cliente.
DIRECT_URL=
# Adapter Meta; versão fixada de acordo com a app aprovada.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_CONFIG_ID=
META_VERIFY_TOKEN=
# Adapter QR experimental: alojamento e credenciais de operador.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_SECRET=
# Apenas no frontend: identificadores públicos, nunca o app secret.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v26.0
# O host Next.js deve configurar um fornecedor de identidade (ex.: Clerk).
