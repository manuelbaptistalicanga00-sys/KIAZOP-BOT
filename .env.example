ANTHROPIC_API_KEY=
WA_TOKEN=            # token permanente da WhatsApp Cloud API (Meta)
WA_PHONE_ID=         # ID do número no Meta for Developers
VERIFY_TOKEN=        # inventa uma palavra-passe; usa a mesma no webhook da Meta
OWNER_PHONE=         # número do dono, ex: 244900000000
ADMIN_KEY=           # chave para ver /agendamentos
APP_SECRET=          # "App Secret" da app Meta (valida a origem das mensagens)
LIMITE_HORA=30       # máx. mensagens por cliente por hora
DB_PATH=bot.db
