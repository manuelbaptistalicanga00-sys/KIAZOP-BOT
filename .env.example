# Um negócio por instalação. Use bases e credenciais distintas para demo/staging/produção.
DEMO_MODE=false
ADMIN_KEY=
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5-20250929
WA_TOKEN=
WA_PHONE_ID=
WA_API_VERSION=v23.0
VERIFY_TOKEN=
APP_SECRET=
OWNER_PHONE=
# Template de alerta SEM parâmetros, previamente aprovado na Meta. Obrigatório fora
# da janela do dono de 24 h. Ausência/falha fica visível no painel, nunca silenciosa.
OWNER_TEMPLATE_NAME=
OWNER_TEMPLATE_LANGUAGE=pt_PT
LIMITE_HORA=30
# Apenas local: mesmo ficheiro/volume para API e worker, num único host.
DB_PATH=bot.db
# Excepção exclusiva de teste local não-demo. Nunca activar em produção.
ALLOW_SQLITE=false
# PostgreSQL: URL pooled de aplicação (ex. Neon, transaction pooling suportado).
# Nunca escrever o valor real no Git. API e worker usam a mesma base dedicada.
DATABASE_URL=
# Worker sempre ligado: python worker.py --concurrency 4. Nunca em função Vercel.
WORKER_LEASE_SECONDS=300
# Cifragem Fernet: chaves separadas por vírgulas, a nova primeiro; nunca no Git/chat.
# Gerar localmente: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEYS=
# Só temporariamente na cópia de migração, não deixar activo em produção.
ALLOW_LEGACY_PLAINTEXT=false
# Limita apenas assinaturas HMAC inválidas; pedidos válidos não consomem.
WEBHOOK_RATE_PER_MINUTE=120
# Estimativas em USD, não uma garantia de facturação. Confirmar preços do MODEL.
AI_DAILY_BUDGET_USD=5
AI_INPUT_USD_PER_MILLION=3
AI_OUTPUT_USD_PER_MILLION=15
